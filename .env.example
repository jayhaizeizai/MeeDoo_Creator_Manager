NODE_ENV=production
APP_ORIGIN=https://creator.meedoo.fun
PORT=4317
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ALLOWED_TENANTS=
LARK_ALLOWED_OPEN_IDS=
LARK_ADMIN_OPEN_IDS=
DB_PATH=/var/lib/meedoo-creator/workspace.sqlite
WORK_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
OPENAI_REASONING_EFFORT=medium

AI_PROVIDER=openai
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_REGION=global

# Discover worker: keep its model/key separate from mail drafting.
SCRAPECREATORS_API_KEY=
DISCOVER_OPENAI_API_KEY=
DISCOVER_DATA_DIR=/var/lib/meedoo-creator/discover
DISCOVER_CONCURRENCY=10
# Map verified reviewer Open IDs to an existing Creator List ID.
REVIEW_LIST_ASSIGNMENTS={}
