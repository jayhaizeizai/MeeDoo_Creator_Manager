import {mountThread,renderBody} from '/mail-view.mjs';
const failures=[];const check=(v,label)=>{if(!v)failures.push(label);};
const malicious='<p>Hello <strong>Louise</strong>,</p><p>Thanks for your reply. <a href="https://example.com/lookbook">View the lookbook</a>.</p><table><tr><th>Look</th><th>Size</th></tr><tr><td>Ivory</td><td>Small</td></tr></table><img src="https://example.invalid/tracker" alt="Lookbook"><script>window.pwned=true</script><iframe src="https://example.invalid"></iframe><form action="https://example.invalid"><input name="secret"></form><a href="javascript:alert(1)" onclick="alert(1)">Bad link</a><div style="background:url(https://example.invalid/tracker)">Warmly,<br>Jay</div><blockquote>On Monday, Louise wrote:<br>Could you share the next steps?</blockquote>';
mountThread(document.querySelector('.email-thread'),[{from:'Jay Lee <jay@example.test>',to:'Louise <louise@example.test>',at:'1791350000000',html_body:malicious,body:'Hello Louise'},{from:'Mail delivery service',to:'jay@example.test',body:"Delivery has failed to these recipients:\n\nlouise@example.test\nThe recipient’s mailbox is full. Please try again later.\n\nDiagnostic information for administrators:\nGenerating server: test.example\nRemote server returned 554 5.2.2 mailbox full\nStack trace...",at:'1791350060000'}]);
const roots=[...document.querySelectorAll('.email-body')].map(x=>x.shadowRoot);const html=roots[0],plain=roots[1];
check(html.querySelector('strong')?.textContent==='Louise','bold retained');check(html.querySelectorAll('td').length===2,'table retained');check(!html.querySelector('script,iframe,form,input,svg,style'),'active elements removed');check(!html.querySelector('[src],[srcset],[style],[onclick],[id]'),'active attributes removed');check(![...html.querySelectorAll('a')].some(x=>x.getAttribute('href')?.startsWith('javascript:')),'unsafe URLs removed');check(html.querySelector('a[href]')?.rel==='noopener noreferrer','safe external links');check(html.querySelector('.image-placeholder')?.textContent==='图片：Lookbook','remote image placeholder');check(html.querySelector('details')&&!html.querySelector('details').open,'quote folded');check(plain.querySelector('details')?.textContent.includes('Generating server'),'diagnostic folded');check(plain.textContent.includes('mailbox is full'),'bounce retained');check(!window.pwned,'scripts not executed');
const host=document.createElement('div');document.body.append(host);const fallback=renderBody(host,{body:'<img src=x onerror=alert(1)>\nOn Monday someone wrote:\n> older text'});check(!fallback.querySelector('img'),'plain text escaped');check(fallback.querySelector('details'),'plain quote folded');host.remove();
await Promise.all(roots.map(r=>new Promise(resolve=>{const link=r.querySelector('link');if(link.sheet)resolve();else{link.onload=resolve;link.onerror=resolve;}})));
check(getComputedStyle(html.querySelector('p')).fontSize==='15px','readable type');
document.querySelector('#test-results').textContent=failures.length?'FAIL: '+failures.join(', '):'PASS — 14 rendering and safety checks · 本地虚构邮件';
